<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Xbox - Video Games & Consoles</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
     .carousel-dot {
      transition: all 0.3s ease;
    }
    .carousel-dot.active {
      background-color: white;
      width: 24px;
      border-radius: 4px;
    }
  </style>
</head>
<body class="font-sans">
  <!-- Navigation Bar -->
  <header class="bg-white px-6 py-3 flex items-center justify-between border-b border-gray-200">
    <div class="flex items-center space-x-8">
      <!-- Microsoft Logo -->
      <div class="flex items-center space-x-6">
        <a href="#" class="flex items-center">
          <img src="/api/placeholder/90/30" alt="Microsoft" class="h-6"/>
        </a>
        <div class="h-6 w-px bg-gray-300"></div>
        <a href="#" class="flex items-center">
          <img src="/api/placeholder/80/30" alt="Xbox" class="h-6"/>
        </a>
      </div>

      <!-- Navigation Links -->
      <nav class="hidden md:flex space-x-2">
        <a href="#" class="px-2 py-2 text-sm font-medium hover:underline flex items-center">
          Game Pass <svg class="ml-1 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </a>
        <a href="#" class="px-2 py-2 text-sm font-medium hover:underline flex items-center">
          Games <svg class="ml-1 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </a>
        <a href="#" class="px-2 py-2 text-sm font-medium hover:underline flex items-center">
          Devices <svg class="ml-1 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </a>
        <a href="#" class="px-2 py-2 text-sm font-medium hover:underline flex items-center">
          Store <svg class="ml-1 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </a>
        <a href="#" class="px-2 py-2 text-sm font-medium hover:underline flex items-center">
          Community <svg class="ml-1 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </a>
        <a href="#" class="px-2 py-2 text-sm font-medium hover:underline flex items-center">
          Support <svg class="ml-1 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </a>
        <a href="#" class="px-2 py-2 text-sm font-medium hover:underline flex items-center">
          Developers <svg class="ml-1 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </a>
      </nav>
    </div>

    <div class="flex items-center space-x-4">
      <div class="flex items-center">
        <a href="#" class="text-sm font-medium hover:underline flex items-center">
          All Microsoft <svg class="ml-1 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </a>
      </div>
      <div class="relative">
        <input type="text" placeholder="Search" class="pl-8 pr-4 py-1 rounded-md border border-gray-300 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500 hidden md:block">
        <div class="absolute inset-y-0 left-0 pl-2 flex items-center pointer-events-none">
          <svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
      <a href="#" class="text-sm font-medium hover:underline flex items-center">
        Cart <svg class="ml-1 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
      </a>
      <a href="#" class="text-sm font-medium hover:underline flex items-center">
        Sign in <img src="/api/placeholder/30/30" alt="Account" class="h-8 w-8 rounded-full ml-2">
      </a>
    </div>
  </header>

  <!-- Main Content -->
  <main>
    <!-- Hero Carousel Section -->
    <section class="relative">
      <div class="w-full h-[450px] bg-black relative overflow-hidden">
        <!-- Hero image background -->
        <img src="https://store-images.s-microsoft.com/image/apps.1783.14098195892151858.0c264d07-c787-4bce-8bb8-09f3ee64f251.07891cdc-201a-4cdd-8026-3175cf1cc302" alt="33 Immortals Game" class="w-full h-full object-cover opacity-90">
        
        <!-- Hero Content -->
        <div class="absolute top-0 left-0 w-full h-full flex items-center">
          <div class="container mx-auto px-8">
            <div class="max-w-lg">
              <div class="inline-block px-3 py-1 text-xs font-bold bg-yellow-400 text-black mb-4">
                XBOX SERIES X|S - PC
              </div>
              <h1 class="text-5xl font-bold text-white mb-4">33 Immortals (Game Preview)</h1>
              <p class="text-xl text-white mb-8">Face the wrath of God with PC Game Pass or Ultimate.</p>
              
              <div class="flex space-x-4">
                <a href="#" class="px-6 py-3 bg-green-500 text-black font-bold uppercase flex items-center hover:bg-green-400 transition">
                  Get it now <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </a>
                <a href="#" class="px-6 py-3 bg-transparent text-white border border-white font-bold uppercase flex items-center hover:bg-white hover:bg-opacity-20 transition">
                  Join game pass <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Navigation Arrows -->
        <button class="absolute left-2 top-1/2 transform -translate-y-1/2 w-10 h-10 bg-black bg-opacity-50 rounded-full flex items-center justify-center text-white">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <button class="absolute right-2 top-1/2 transform -translate-y-1/2 w-10 h-10 bg-black bg-opacity-50 rounded-full flex items-center justify-center text-white">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
        
        <!-- Carousel Indicator -->
        <div class="absolute bottom-4 left-0 right-0 flex justify-center space-x-2">
          <button class="h-2 rounded-full bg-gray-500 w-2"></button>
          <button class="h-2 rounded-full bg-white w-6"></button>
          <button class="h-2 rounded-full bg-gray-500 w-2"></button>
        </div>
      </div>
    </section>

    <!-- Quick Links -->
    <section class="py-8 bg-white">
      <div class="container mx-auto flex justify-center space-x-16">
        <a href="#" class="flex flex-col items-center group">
          <div class="w-16 h-16 flex items-center justify-center text-green-700">
            <svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
            </svg>
          </div>
          <span class="text-sm font-bold text-green-700 mt-2 group-hover:underline">SHOP DEALS</span>
        </a>
        
        <a href="#" class="flex flex-col items-center group">
          <div class="w-16 h-16 flex items-center justify-center text-green-700">
            <svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
            </svg>
          </div>
          <span class="text-sm font-bold text-green-700 mt-2 group-hover:underline">REDEEM CODE</span>
        </a>
        
        <a href="#" class="flex flex-col items-center group">
          <div class="w-16 h-16 flex items-center justify-center text-green-700">
            <svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
          </div>
          <span class="text-sm font-bold text-green-700 mt-2 group-hover:underline">WISH LIST</span>
        </a>
      </div>
    </section>
    
    <!-- Browse All Games Section -->
    <section class="bg-gray-50 pt-4">
      <div class="container mx-auto px-6">
        <div class="flex justify-end mb-4">
          <a href="#" class="text-green-700 font-bold flex items-center text-sm">
            BROWSE ALL GAMES <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- New Releases Section -->
    <section class="bg-gray-50 py-6">
      <div class="container mx-auto px-6">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-3xl font-bold">New Releases</h2>
          <a href="#" class="text-green-700 font-bold flex items-center">
            SHOP ALL <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 relative">
          <!-- Game Card 1 -->
          <div class="bg-white rounded overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <a href="#">
              <img src="https://store-images.s-microsoft.com/image/apps.1783.14098195892151858.0c264d07-c787-4bce-8bb8-09f3ee64f251.07891cdc-201a-4cdd-8026-3175cf1cc302" alt="World of Warships: Legends" class="w-full h-48 object-cover">
              <div class="p-3">
                <h3 class="font-semibold text-sm mb-1">World of Warships: Legends – Captain's Essentials</h3>
              </div>
            </a>
          </div>
          
          <!-- Game Card 2 -->
          <div class="bg-white rounded overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <a href="#">
              <img src="/api/placeholder/300/180" alt="Crystal Ball of Firmament" class="w-full h-48 object-cover">
              <div class="p-3">
                <h3 class="font-semibold text-sm mb-1">Crystal Ball of Firmament (Xbox One)</h3>
              </div>
            </a>
          </div>
          
          <!-- Game Card 3 -->
          <div class="bg-white rounded overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <a href="#">
              <img src="/api/placeholder/300/180" alt="Crystal Ball of Firmament" class="w-full h-48 object-cover">
              <div class="p-3">
                <h3 class="font-semibold text-sm mb-1">Crystal Ball of Firmament</h3>
              </div>
            </a>
          </div>
          
          <!-- Game Card 4 -->
          <div class="bg-white rounded overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <a href="#">
              <img src="/api/placeholder/300/180" alt="Monument Valley" class="w-full h-48 object-cover">
              <div class="p-3">
                <h3 class="font-semibold text-sm mb-1">Monument Valley</h3>
              </div>
            </a>
          </div>
          
          <!-- Game Card 5 -->
          <div class="bg-white rounded overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <a href="#">
              <img src="/api/placeholder/300/180" alt="Monument Valley 2" class="w-full h-48 object-cover">
              <div class="p-3">
                <h3 class="font-semibold text-sm mb-1">Monument Valley 2</h3>
              </div>
            </a>
          </div>
          
          <!-- Game Card 6 -->
          <div class="bg-white rounded overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <a href="#">
              <img src="/api/placeholder/300/180" alt="Hot Rod Mayhem" class="w-full h-48 object-cover">
              <div class="p-3">
                <h3 class="font-semibold text-sm mb-1">Hot Rod Mayhem</h3>
              </div>
            </a>
          </div>
          
          <!-- Navigation button -->
          <button class="absolute -right-4 top-1/2 transform -translate-y-1/2 w-8 h-8 bg-white rounded-full shadow-md flex items-center justify-center">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </div>
    </section>

    <!-- Best Sellers Section -->
    <section class="bg-gray-50 py-8">
      <div class="container mx-auto px-6">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-3xl font-bold">Best sellers</h2>
          <a href="#" class="text-green-700 font-bold flex items-center">
            SHOP ALL <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 relative">
          <!-- Game Card 1 -->
          <div class="bg-white rounded overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <a href="#">
              <img src="/api/placeholder/300/180" alt="Inside Limbo" class="w-full h-48 object-cover">
              <div class="p-3">
                <h3 class="font-semibold text-sm mb-1">Inside Limbo</h3>
              </div>
            </a>
          </div>
          
          <!-- Game Card 2 -->
          <div class="bg-white rounded overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <a href="#">
              <img src="/api/placeholder/300/180" alt="Red Dead Redemption" class="w-full h-48 object-cover">
              <div class="p-3">
                <h3 class="font-semibold text-sm mb-1">Red Dead Redemption</h3>
              </div>
            </a>
          </div>
          
          <!-- Game Card 3 -->
          <div class="bg-white rounded overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <a href="#">
              <img src="/api/placeholder/300/180" alt="FC25" class="w-full h-48 object-cover">
              <div class="p-3">
                <h3 class="font-semibold text-sm mb-1">EA Sports FC25</h3>
              </div>
            </a>
          </div>
          
          <!-- Game Card 4 -->
          <div class="bg-white rounded overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <a href="#">
              <img src="/api/placeholder/300/180" alt="Devil May Cry 5" class="w-full h-48 object-cover">
              <div class="p-3">
                <h3 class="font-semibold text-sm mb-1">Devil May Cry 5</h3>
              </div>
            </a>
          </div>
          
          <!-- Game Card 5 -->
          <div class="bg-white rounded overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <a href="#">
              <img src="/api/placeholder/300/180" alt="Split Fiction" class="w-full h-48 object-cover">
              <div class="p-3">
                <h3 class="font-semibold text-sm mb-1">Split Fiction</h3>
              </div>
            </a>
          </div>
          
          <!-- Game Card 6 -->
          <div class="bg-white rounded overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <a href="#">
              <img src="/api/placeholder/300/180" alt="GTA V" class="w-full h-48 object-cover">
              <div class="p-3">
                <h3 class="font-semibold text-sm mb-1">Grand Theft Auto V</h3>
              </div>
            </a>
          </div>
          
          <!-- Navigation button -->
          <button class="absolute -right-4 top-1/2 transform -translate-y-1/2 w-8 h-8 bg-white rounded-full shadow-md flex items-center justify-center">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </div>
    </section>
  </main>

  <!-- EJS Code for Dynamic Content -->
  <% if (locals.featuredGames) { %>
    <section class="bg-gray-50 py-8">
      <div class="container mx-auto px-6">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-3xl font-bold">Featured Games</h2>
          <a href="#" class="text-green-700 font-bold flex items-center">
            SHOP ALL <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 relative">
          <% featuredGames.forEach(game => { %>
            <div class="bg-white rounded overflow-hidden shadow-sm hover:shadow-md transition-shadow">
              <a href="/game/<%= game.id %>">
                <img src="<%= game.image %>" alt="<%= game.title %>" class="w-full h-48 object-cover">
                <div class="p-3">
                  <h3 class="font-semibold text-sm mb-1"><%= game.title %></h3>
                  <% if (game.price) { %>
                    <p class="text-sm font-bold">$<%= game.price %></p>
                  <% } %>
                </div>
              </a>
            </div>
          <% }); %>
        </div>
      </div>
    </section>
  <% } %>

  <script>
    // Simple carousel functionality
    document.addEventListener('DOMContentLoaded', function() {
      const dots = document.querySelectorAll('.carousel-dot');
      dots.forEach(dot => {
        dot.addEventListener('click', function() {
          dots.forEach(d => d.classList.remove('active'));
          this.classList.add('active');
        });
      });
    });
  </script>
</body>
</html>